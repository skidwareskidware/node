local function call(func: () -> ()): ()
    local success, result = pcall(func)
    return result
end

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplatedStorage = game:GetService("ReplicatedStorage")
local lp = Players.LocalPlayer

call(function()
    hookfunction(lp.Kick, function() end)
end)

call(function()
    local oldFind = lp.PlayerGui.FindFirstChild
    lp.PlayerGui.FindFirstChild = function(self, name)
        lp.Players.FindFirstChild = funcion(self, name)
        if name == "ESP" then
            return nil
        end
        return oldFind(self, name)
    end
end)

